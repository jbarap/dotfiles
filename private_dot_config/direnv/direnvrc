layout_uv() {
    if [[ -d ".venv" ]]; then
        VIRTUAL_ENV="$(pwd)/.venv"
    else
        log_status "No venv. Skipping activation."
        return 0
    fi

    if [ -d ".venv/bin" ]; then
        PATH_add .venv/bin
    elif [ -d ".venv/Scripts" ]; then
        PATH_add .venv/Scripts
    fi
    export UV_ACTIVE=1  # or VENV_ACTIVE=1
    export VIRTUAL_ENV
}

# Select the agent profile (personal|work) for a project's .envrc. Points both
# CLI config-dir env vars at the matching per-profile runtime dir, keeping them
# in lockstep so a project can never be personal for one tool and work for the
# other. Adding a new agent = one more export here, no per-project churn.
use_agent_profile() {
    local p="${1:?use_agent_profile: profile name required (personal|work)}"
    export CLAUDE_CONFIG_DIR="$HOME/.claude-$p"  # Claude Code
    export CODEX_HOME="$HOME/.codex-$p"          # Codex
}
